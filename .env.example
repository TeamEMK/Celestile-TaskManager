# ─────────────────────────────────────────────────────────────
# Celestile-TaskManager — environment variables
# Copy to .env.local (local) or set these in the Hostinger Node.js app.
# ─────────────────────────────────────────────────────────────

# MySQL / MariaDB (Hostinger: hPanel → Databases → MySQL Databases)
# When these are set (and SHEETS_DB_ID is NOT), the app uses MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=uXXXXXXXX_celestile
DB_PASSWORD=your-db-password
DB_NAME=uXXXXXXXX_celestile

# Auth (NextAuth)
# NEXTAUTH_SECRET: any long random string  →  run:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Your live URL (the domain the app runs on)
NEXTAUTH_URL=https://yourdomain.com

# Secret for /api/init-admin and the Developer page
DEVELOPER_SECRET=change-me

# WhatsApp (Maytapi) — optional; needed for notifications
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_TOKEN=
# Per-branch / inventory notification numbers (optional)
QUOTATION_NOTIFY_BNG=918050005533
QUOTATION_NOTIFY_HYD=918008002121
INVENTORY_NOTIFY=918008002121

# ⚠️ Do NOT set SHEETS_DB_ID on the MySQL host — leaving it unset keeps the
# app on MySQL. (Setting it would switch the app to Google Sheets mode.)
# SHEETS_DB_ID=
