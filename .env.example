# ─────────────────────────────────────────────────────────────
# Celestile-TaskManager — environment variables
# Copy to .env.local (local) or set these in the Hostinger Node.js app.
# ─────────────────────────────────────────────────────────────

# MySQL / MariaDB (Hostinger: hPanel → Databases → MySQL Databases)
# When these are set (and SHEETS_DB_ID is NOT), the app uses MySQL.
DB_HOST=localhost
DB_PORT=3306
DB_USER=uXXXXXXXX_celestile
DB_PASSWORD=your-db-password
DB_NAME=uXXXXXXXX_celestile

# Auth (NextAuth)
# NEXTAUTH_SECRET: any long random string  →  run:  openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-a-long-random-string
# Your live URL (the domain the app runs on)
NEXTAUTH_URL=https://yourdomain.com

# Secret for /api/init-admin and the Developer page
DEVELOPER_SECRET=change-me

# WhatsApp (Maytapi) — optional; needed for notifications
MAYTAPI_PRODUCT_ID=
MAYTAPI_PHONE_ID=
MAYTAPI_TOKEN=
# Per-branch / inventory notification numbers (optional)
QUOTATION_NOTIFY_BNG=918050005533
QUOTATION_NOTIFY_HYD=918008002121
# Slab BLOCKED / RELEASED alerts. Accepts a plain number or a group JID (…@g.us);
# defaults to the inventory group below. NOTE: /api/inventory/step2 reads the
# same variable for its cutting summary, so setting it moves that too.
INVENTORY_NOTIFY=120363428784416671@g.us
# WhatsApp group JID (…@g.us) the designer daily report is posted to —
# one message per designer, every day except Sunday. Get the JID from the
# Maytapi dashboard's Group List, or from a webhook log of a past group
# message. Falls back to the current design group if unset.
DESIGN_GROUP_ID=918050005533-1568964481@g.us

# Secret for scheduled/cron routes (/api/reminders, /api/reminders/design-report).
# Set this, then point an external scheduler (Hostinger cron job, cron-job.org,
# or Vercel Cron) at the URL with header  Authorization: Bearer <CRON_SECRET>.
#   /api/reminders              — daily, any time (overdue/checklist/FMS reminders)
#   /api/reminders/design-report — "30 20 * * 1-6" IST (= "0 15 * * 1-6" UTC)
# For manual testing without a cron header, append ?secret=<DEVELOPER_SECRET> instead.
CRON_SECRET=change-me

# Google Service Account — needed for FMS "Import from Sheet" AND for
# uploading photo/PDF attachments to Google Drive (see below).
# Create at: console.cloud.google.com → IAM → Service Accounts → Keys (JSON)
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# If the panel mangles that multi-line value the app reports
# "DECODER routines::unsupported". Two panel-proof alternatives — use either:
#   a) upload the downloaded JSON key file as credentials.json in the app
#      folder (it is gitignored, and does NOT switch the app to Sheets mode
#      unless SHEETS_DB_ID is also set), or
#   b) set the single line below to that JSON file base64-encoded:
#      base64 -w0 service-account.json
# GOOGLE_CREDENTIALS_JSON=
# Check what the app actually resolved:  https://yourdomain.com/api/drive-check

# Photo/PDF attachments (Delegate Task, Checklist, Inventory, Daily Task,
# Quotation items, user/profile pictures) go to Google Drive using the service
# account above, instead of being stored inline in the database. They are not
# made link-shareable — they are served back to signed-in users through
# /api/drive/<id>, so they keep working even where the Workspace blocks
# sharing outside the domain.
#
# It must be a SHARED DRIVE, and the service account must be a MEMBER of it
# (Content manager). A folder in someone's My Drive does not work: the service
# account has no storage quota to own files with, and cannot even see a folder
# shared to it once the org disallows external sharing.
# By default the app finds-or-creates "Celestile Attachments" at the root of
# the shared drive wired into lib/googleDrive.js. Override either the drive or
# an exact destination folder:
# GOOGLE_DRIVE_ID=
# GOOGLE_DRIVE_FOLDER_ID=

# ⚠️ Do NOT set SHEETS_DB_ID on the MySQL host — leaving it unset keeps the
# app on MySQL. (Setting it would switch the app to Google Sheets mode.)
# SHEETS_DB_ID=
